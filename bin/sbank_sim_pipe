###############################################################################

def default_log_dir():
    """Portable fallback for the condor DAG log directory.

    WP7 audit item 5: this used to be a hardcoded per-host table
    (caltech.edu/phys.uwm.edu/aei.uni-hannover.de/phy.syr.edu -> a
    site-specific local-scratch path, else tempfile.gettempdir()). That
    table doesn't generalize to the IGWN pool (arbitrary submit hosts, not
    just the four LDG sites it knew about) and silently falls back to
    tempfile.gettempdir() for everyone else anyway. Replaced by an explicit
    --log-dir CLI option (see parse_command_line); this function is only the
    default when --log-dir is not given.
    """
    return tempfile.gettempdir()

class bank_DAG(pipeline.CondorDAG):

    def __init__(self, name, logpath=None):
        if logpath is None:
            logpath = default_log_dir()
        self.basename = name
        tempfile.tempdir = logpath
        tempfile.template = self.basename + '.dag.log.'
        logfile = tempfile.mktemp()
        fh = open( logfile, "w" )
        fh.close()
        pipeline.CondorDAG.__init__(self,logfile)
        self.set_dag_file(self.basename)
        self.jobsDict = {}
        self.node_id = 0
        self.output_cache = []

    def add_node(self, node):
        node.set_retry(3)
        self.node_id += 1
        node.add_macro("macroid", self.node_id)
        pipeline.CondorDAG.add_node(self, node)

    def write_cache(self):
        out = self.basename + ".cache"
        f = open(out,"w")
        for c in self.output_cache:
            f.write(str(c)+"\n")
        f.close()


###############################################################################
#
# WP7 audit helpers -- IGWN-pool readiness (accounting/resources/transfer/
# container/retry-policy). Each is an opt-in, ini-driven, generic addition:
# an ini file with none of these new sections behaves exactly as before.
# See .claude-wp/WP7_report.md Part A for the full item-by-item audit this
# implements.
#
###############################################################################

def _apply_accounting(job, cp):
    """accounting_group / accounting_group_user (WP7 audit item 1).

    accounting_group was already supported (via an [accounting] ini
    section); accounting_group_user was not, even though the sibling
    bin/sbank_pipe already supports both (see its SBankJob/LWAddJob/
    SBankChooseMchirpBoundariesJob) -- this makes sbank_sim_pipe match that
    existing, already-in-repo pattern. IGWN requires accounting_group on
    every job; accounting_group_user is required only for shared/service
    accounts.
    """
    if cp.has_section("accounting"):
        if cp.has_option("accounting", "accounting-group"):
            job.add_condor_cmd('accounting_group', cp.get("accounting", "accounting-group"))
        if cp.has_option("accounting", "accounting-group-user"):
            job.add_condor_cmd('accounting_group_user', cp.get("accounting", "accounting-group-user"))


def _apply_resources(job, cp, tag, default_memory, default_disk, default_cpus=None):
    """request_memory / request_disk / request_cpus (WP7 audit item 2).

    Previously hardcoded per job class (1999/3999 MB, 1MB disk, cpus only
    from the DAG-generation host's OMP_NUM_THREADS env var) with no way to
    override from the ini. Now overridable per job-type via an optional
    ini [condor-resources] section (keys "<tag>-memory"/"<tag>-disk"/
    "<tag>-cpus"); falls back to the historical hardcoded defaults so an
    ini without this section submits identical jobs to before.
    """
    section = "condor-resources"
    def _opt(name, default):
        key = "%s-%s" % (tag, name)
        if cp.has_section(section) and cp.has_option(section, key):
            return cp.get(section, key)
        return str(default)
    job.add_condor_cmd('request_memory', _opt("memory", default_memory))
    job.add_condor_cmd('request_disk', _opt("disk", default_disk))
    cpus = None
    if cp.has_section(section) and cp.has_option(section, "%s-cpus" % tag):
        cpus = cp.get(section, "%s-cpus" % tag)
    elif default_cpus is not None:
        cpus = str(default_cpus)
    elif "OMP_NUM_THREADS" in os.environ:
        # Legacy behavior, kept for back-compat: sniffs the DAG-generation
        # host's OMP_NUM_THREADS. An explicit "<tag>-cpus" ini value (above)
        # always wins and is the recommended way to set this for IGWN pool
        # submission, where the generating host's env has no relationship
        # to the execute node.
        cpus = os.environ["OMP_NUM_THREADS"]
    if cpus is not None:
        job.add_condor_cmd('request_cpus', cpus)


def _apply_transfer(job, cp, static_input_files=()):
    """should_transfer_files / when_to_transfer_output / transfer_input_files
    (WP7 audit item 3). Off by default (preserves the historical
    shared-filesystem assumption); opt in with:

        [transfer]
        should-transfer-files = YES
        ; when-to-transfer-output = ON_EXIT_OR_EVICT   (default)
        ; extra-input-files = /path/one,/path/two

    AUDIT FINDING (verified against the installed glue.pipeline source,
    .venv-test/lib/python3.11/site-packages/glue/pipeline.py):
    CondorDAGNode.add_input_file()/add_file_opt() only feed
    transfer_input_files into the submit file for the 'grid' universe --
    for 'vanilla' (what every job class here uses) they only affect DAG
    dependency bookkeeping (get_input_files()/get_output_files()), not the
    written .sub file. So transfer_input_files below is necessarily a
    JOB-level static list (the reference PSD / template-bank files, which
    the '# CREATE DAG' campaign loop further down holds constant across
    every node of a given job class) -- the per-node injection file is NOT
    included, because a single BankSimJob instance is shared across every
    injection run (inj_run) in the campaign loop, each with a different
    injection file, and glue.pipeline's vanilla-universe writer has no
    per-node (VARS-macro-based) transfer_input_files hook to attach it to.
    Two ways to run a campaign that actually needs this: (a) a shared
    filesystem for the injection XML (the unchanged default), or (b) the
    new bin/sbank_sim_dag_config generator (WP7 Part B), which writes its
    own DAG/.sub files with per-node VARS macros and handles this
    correctly. FLAGGED FOR REVIEWER: read from source, not exercised
    against a live IGWN schedd from this environment (no condor here).
    """
    if not (cp.has_section("transfer") and cp.has_option("transfer", "should-transfer-files")
            and cp.getboolean("transfer", "should-transfer-files")):
        return
    job.add_condor_cmd('should_transfer_files', 'YES')
    when = 'ON_EXIT_OR_EVICT'
    if cp.has_option("transfer", "when-to-transfer-output"):
        when = cp.get("transfer", "when-to-transfer-output")
    job.add_condor_cmd('when_to_transfer_output', when)
    files = list(static_input_files)
    if cp.has_option("transfer", "extra-input-files"):
        files.extend(f.strip() for f in cp.get("transfer", "extra-input-files").split(",") if f.strip())
    if files:
        job.add_condor_cmd('transfer_input_files', ','.join(files))


def _apply_container(job, cp):
    """Apptainer/Singularity execution on the IGWN pool (WP7 audit item 4,
    Part C image). Off by default; opt in with:

        [container]
        image = osdf:///path/to/sbank-igwn.sif

    Emits both the HTCondor container-universe attribute (`container_image`,
    documented for osdf:// / cvmfs:// image URLs) and the older
    `+SingularityImage` classad some pool nodes still key off of, so one ini
    setting works across a pool mid-migration. SOURCE: HTCondor manual
    `container_image` submit command + IGWN/OSG container-submission
    convention as I know it -- NOT verified against a live IGWN submit host
    from this environment (no condor installed here). FLAGGED FOR REVIEWER:
    confirm against current computing.docs.ligo.org container guidance
    before relying on both attributes simultaneously in production.

    getenv hygiene: jobs historically ran with getenv=True (leaks the
    submit host's full environment into the job -- harmless outside a
    container on a shared-FS pool, but can shadow a container's own
    library paths from the inside). When a container image is configured
    this uses an explicit allowlist (OMP_NUM_THREADS, OPENBLAS_NUM_THREADS
    -- the two variables this repo's scripts rely on per CLAUDE.md) instead
    of blanket True.
    """
    if not (cp.has_section("container") and cp.has_option("container", "image")):
        job.add_condor_cmd('getenv', 'True')
        return
    image = cp.get("container", "image")
    job.add_condor_cmd('container_image', image)
    job.add_condor_cmd('+SingularityImage', '"%s"' % image)
    job.add_condor_cmd('getenv', 'OMP_NUM_THREADS,OPENBLAS_NUM_THREADS')


def _apply_policies(job, cp):
    """Optional retry-priority/hold-handling passthrough (WP7 audit item 7),
    ini [policy] section. All opt-in; an ini without this section changes
    nothing. (DAG-level RETRY is already applied uniformly by
    bank_DAG.add_node -> node.set_retry(3) for every node; that default is
    unchanged.)
    """
    if not cp.has_section("policy"):
        return
    if cp.has_option("policy", "priority"):
        job.add_condor_cmd('priority', cp.get("policy", "priority"))
    if cp.has_option("policy", "periodic-release"):
        job.add_condor_cmd('periodic_release', cp.get("policy", "periodic-release"))
    if cp.has_option("policy", "periodic-hold"):
        job.add_condor_cmd('periodic_hold', cp.get("policy", "periodic-hold"))
    if cp.has_option("policy", "periodic-remove"):
        job.add_condor_cmd('periodic_remove', cp.get("policy", "periodic-remove"))


def _static_banksim_inputs(cp):
    """Best-effort static input-file list (reference PSD + template-bank
    paths) read from the [banksim] ini section, for _apply_transfer's
    job-level transfer_input_files. Generic/ini-driven only -- no
    site-specific paths hardcoded here.
    """
    files = []
    if cp.has_option("banksim", "reference-psd"):
        files.append(cp.get("banksim", "reference-psd").strip())
    if cp.has_option("banksim", "template-bank"):
        for line in cp.get("banksim", "template-bank").splitlines():
            line = line.strip()
            if line:
                files.append(line.split(":")[0])
    return files


class InspinjJob(InspiralAnalysisJob):
    def __init__(self, cp, tag_base="inspinj"):
        exec_name = 'lalapps_inspinj'
        extension = 'xml'
        sections = ['inspinj']
        InspiralAnalysisJob.__init__(self,cp,sections,exec_name,extension)
        self.set_universe("local")
        self.set_sub_file(tag_base+'.sub')
        self.tag_base = tag_base
        _apply_resources(self, cp, "inspinj", 1999, "1MB")
        self.set_stdout_file('logs/'+tag_base+'-$(macroid)-$(process).out')
        self.set_stderr_file('logs/'+tag_base+'-$(macroid)-$(process).err')
        _apply_accounting(self, cp)
        _apply_policies(self, cp)


class InspinjNode(pipeline.CondorDAGNode):
    def __init__(self, job, dag, tag=None, seed=0, p_node=[]):
        pipeline.CondorDAGNode.__init__(self,job)
        self.add_var_opt("seed", seed)
        outputFile = "HL-INJECTIONS_" + str(seed)
        if tag is not None:
            outputFile += "_" + tag
        opts = self.job().get_opts()
        outputFile += "-" + opts["gps-start-time"] + "-" + str(int(opts["gps-end-time"]) - int(opts["gps-start-time"])) + ".xml"
        self.add_var_opt("output", outputFile)
        self.add_output_file(outputFile)
        for p in p_node:
            self.add_parent(p)
        dag.add_node(self)

class NoIlwdJob(InspiralAnalysisJob):
    """Strips legacy ilwd:char typing from injection XML via
    ligolw_no_ilwdchar (WP7 audit item 6). STILL NEEDED post-igwn_ligolw
    migration -- in fact *more* necessary than before: igwn_ligolw dropped
    ilwdchar support entirely (see .claude-wp/WP1_report.md, the
    'Move to igwn_ligolw' upstream merge), so any legacy GstLAL-era
    injection XML that still carries ilwd:char IDs can no longer be read by
    this codebase's own igwn_ligolw-based tooling at all without this strip
    step running first. TOOL AVAILABILITY: ligolw_no_ilwdchar ships with
    python-ligo-lw, NOT igwn-ligolw -- the two packages must be installed
    side by side for this job to run (confirmed on the locally verified env
    in .claude-wp/env_build.log / WP1_report.md, where both were present
    together; the container recipe in container/sbank-igwn.def installs
    both for exactly this reason and documents it in container/README.md).
    """
    def __init__(self, cp, tag_base="ilwdchar"):
        exec_name = 'ligolw_no_ilwdchar'
        extension = 'xml'
        sections = []
        InspiralAnalysisJob.__init__(self,cp,sections,exec_name,extension)
        self.set_universe("local")
        self.tag_base = tag_base
        _apply_resources(self, cp, "ilwdchar", 1999, "1MB")
        self.set_stdout_file('logs/'+tag_base+'-$(macroid)-$(process).out')
        self.set_stderr_file('logs/'+tag_base+'-$(macroid)-$(process).err')
        _apply_accounting(self, cp)
        _apply_policies(self, cp)


class NoIlwdNode(pipeline.CondorDAGNode):
    def __init__(self, job, dag, injs, p_node=[]):
        pipeline.CondorDAGNode.__init__(self,job)
        self.add_file_arg(injs)
        #self.add_output_file(outputFile)
        for p in p_node:
            self.add_parent(p)
        dag.add_node(self)

class BankSimJob(InspiralAnalysisJob):
    def __init__(self, cp, tag_base ="banksim"):
        exec_name = 'sbank_sim'
        extension = 'xml'
        sections = ['banksim']
        InspiralAnalysisJob.__init__(self,cp,sections,exec_name,extension)
        self.tag_base = tag_base
        # WP7 audit item 2: was `add_condor_cmd('request_memory', '3999')`
        # called twice (harmless -- condor keeps the last value -- but a
        # bug); now a single call, overridable per-campaign.
        _apply_resources(self, cp, "banksim", 3999, "1MB")
        self.set_stdout_file('logs/'+tag_base+'$(macroid)-$(cluster)-$(process).out')
        self.set_stderr_file('logs/'+tag_base+'-$(macroid)-$(cluster)-$(process).err')
        _apply_accounting(self, cp)
        # WP7 audit item 3/4: transfer + container are the two IGWN-pool
        # readiness items most specific to this job (it's the one that
        # actually consumes the PSD/bank/injection files and needs the
        # sbank_sim executable's environment); item 4 also sets getenv.
        _apply_transfer(self, cp, static_input_files=_static_banksim_inputs(cp))
        _apply_container(self, cp)
        _apply_policies(self, cp)


class BankSimNode(pipeline.CondorDAGNode):
    def __init__(self, job, dag, injs, approx, injmin=0, injmax=-1, tag="SIM", p_node=[]):
        pipeline.CondorDAGNode.__init__(self,job)
        self.add_file_opt("injection-file", injs)
        self.add_var_opt("injection-approx", approx)
        self.add_var_opt("injection-min", injmin)
        self.add_var_opt("injection-max", injmax)
        self.add_var_opt("user-tag", tag)
        self.add_output_file("%s.h5" % tag)
        for p in p_node:
            if p is not None:
                self.add_parent(p)
        dag.add_node(self)


class PlotSimJob(InspiralAnalysisJob):
    def __init__(self, cp, tag_base="sbank_plot_sim"):
        exec_name = 'sbank_plot_sim'
        extension = 'h5'
        sections = []
        InspiralAnalysisJob.__init__(self,cp,sections,exec_name,extension)
        self.tag_base = tag_base
        # WP7 audit item 2: removed the duplicate request_memory call
        # (originally set twice, same value both times).
        _apply_resources(self, cp, "plotsim", 3999, "1MB")
        self.set_universe("local")
        self.set_sub_file(tag_base+'.sub')
        self.set_stdout_file('logs/'+tag_base+'-$(macroid)-$(process).out')
        self.set_stderr_file('logs/'+tag_base+'-$(macroid)-$(process).err')
        self.add_condor_cmd('getenv','True')
        _apply_accounting(self, cp)
        _apply_policies(self, cp)


class PlotSimNode(pipeline.CondorDAGNode):
    def __init__(self, job, dag, h5files=[],p_node=[]):
        pipeline.CondorDAGNode.__init__(self,job)
        [self.add_file_arg(h5f) for h5f in h5files]
        for p in p_node:
            self.add_parent(p)
        dag.add_node(self)


usage = """

sbank_sim_pipe generates a DAG for parallelizing the
 verification of template banks via sbank_sim. Its primary
 input is an ini file, which takes form given below. Once you have an
 ini file, create the DAG by

sbank_sim_pipe --config-file INIFILE.ini --user-tag SBANK_PIPE

;;; BEGIN EXAMPLE INI ;;;

[condor] ; This section points to the executables, and provides condor options
universe = vanilla
sbank_sim = /usr/bin/sbank_sim
sbank_plot_sim = /usr/bin/sbank_plot_sim
lalapps_inspinj = /usr/bin/lalapps_inspinj

;[accounting]
;accounting-group = ???
;accounting-group-user = ???             ; only needed for shared/service accounts

; --- WP7 IGWN-pool readiness: all sections below are OPTIONAL and OFF BY
; DEFAULT. Omitting them reproduces this script's pre-WP7 behavior exactly.

;[condor-resources]                      ; per-job-type request_memory/disk/cpus
;banksim-memory = 3999
;banksim-disk = 4096
;banksim-cpus = 1
;inspinj-memory = 1999
;ilwdchar-memory = 1999
;plotsim-memory = 3999

;[transfer]                              ; non-shared-filesystem (OSG/IGWN pool) execution
;should-transfer-files = YES
;when-to-transfer-output = ON_EXIT_OR_EVICT
;extra-input-files = /path/to/extra1,/path/to/extra2

;[container]                             ; run sbank_sim/sbank_plot_sim inside Apptainer
;image = osdf:///igwn/.../sbank-igwn.sif  ; see container/sbank-igwn.def

;[policy]                                ; retry/priority/hold passthrough
;priority = 10
;periodic-release = (HoldReasonCode == 26)
;periodic-hold = (JobStatus == 2) && ((CurrentTime - EnteredCurrentStatus) > 86400)
;periodic-remove = (JobStatus == 5) && ((CurrentTime - EnteredCurrentStatus) > 3600)

[banksim]
; This section contains the parameters of the entire bank parameter
; space you wish to cover. sbank_pipe will divide the space for you.
template-bank = MYBANK1[:MYAPPROX1]
;template-bank = MYBANK2[:MYAPPROX2]
noise-model = aLIGOZeroDetHighPower
; reference-psd = PSD.xml.gz
flow = 30
; extra filters on injection parameters produced by inspinj, if needed
instrument = L1
mtotal-max = 400
mtotal-min = 4
mratio-max = 97
duration-min = 0.2
neighborhood-size = 2.0

[sbank_pipe]
injections-per-job = 100
njobs = 100

;
; FOR BANK SIMS
;
[injections]
; As in the classic IHOPE style, this section is a list of injection
; runs in the format "name" = "seed".
seobnr = 1234
imrc = 1234

[inspinj]
; This section gives options that are common to all injection runs,
; regardless of name or seed. Be careful, since flag options (those
; that set a value to true) cannot be overridden below.
f-lower = 25.0
waveform = SEOBNRv2_ROM_DoubleSpin
l-distr = random
d-distr = volume
i-distr = uniform
max-inc = 179.99
polarization = uniform
min-distance = 10000
max-distance = 1000000
m-distr = componentMass
taper-injection = startend
min-mass1 = 2.0
max-mass1 = 296.0
min-mass2 = 2.0
max-mass2 = 296.0

[seobnr]
; This section overrides the generic inspinj options from the section
; above. If an option is not included here, it will be taken from the
; [inspinj] section. The options in this section apply only to the
; [seobnr] run, in this example.
waveform = SEOBNRv4_ROM
enable-spin =
min-spin1 = 0.0
max-spin1 = 0.98
min-spin2 = 0.0
max-spin2 = 0.98
aligned =

[imrd]
; This section overrides the generic inspinj options from the section
; above. If an option is not included here, it will be taken from the
; [inspinj] section. The options in this section apply only to the
; [imrc] run, in this example.
waveform = IMRPhenomD
enable-spin =
min-spin1 = 0.0
max-spin1 = 0.9
min-spin2 = 0.0
max-spin2 = 0.9
aligned =

;;; END EXAMPLE INI ;;;

"""

###############################################################################
#
# OPTION PARSER
#
###############################################################################

def parse_command_line():
    parser = OptionParser(usage=usage)
    parser.add_option("--config-file", default=None, help="Read options for generating template bank placement pipeline from configuration ini file..")
    parser.add_option("--user-tag", default="SBANK", help="Make your results feel special and give them a unique name.")
    parser.add_option("--log-dir", default=None, metavar="PATH",
                       help="Directory for the condor DAG's own log file (WP7 audit item 5: "
                            "replaces a hardcoded caltech.edu/uwm/aei/syr host table). Defaults "
                            "to tempfile.gettempdir() (e.g. $TMPDIR) if not given.")
    options, filenames = parser.parse_args()

    return options, filenames

options, filenames = parse_command_line()


###############################################################################
#
# CREATE DAG
#
###############################################################################

# READ IN CONFIGPARSER
try: os.mkdir("logs")
except: pass

# read config file
cp = dcConfigParser()
cp.read(options.config_file)

# CREATE TOP LEVEL DAG AND JOBS
dag = bank_DAG(options.user_tag, logpath=options.log_dir)
NoIlwdJob = NoIlwdJob(cp)
banksimJob = BankSimJob(cp)
plotsimJob = PlotSimJob(cp)

# for each injection run and every subbank, perform a banksim
for inj_run in cp.options("injections"):
    # set up inspinj jobs
    # each option in the [injections] section is a separate injection run
    # the inspinj section sets options that are common to all injection runs
    injperjob = int(cp.get("sbank_pipe", "injections-per-job"))
    njobs = int(cp.get("sbank_pipe", "jobs"))

    gpsstart = 1000000000 # irrelevant for banksim.
    # because we will prune injections, we generate 50 times more
    # than we think we need. this is fast.
    # FIXME: this is still no guarantee we have enough injections!!
    gpsend = gpsstart +  (njobs * injperjob)
    cp.set("inspinj", "gps-start-time", str(gpsstart))
    cp.set("inspinj", "gps-end-time", str(gpsend))
    cp.set("inspinj", "time-step", str(1))

    # override default inspinj options with those given in the inj_run section
    for opt in cp.options(inj_run):
        cp.set('inspinj', opt, cp.get(inj_run, opt))

    # set random seed
    seed = int(cp.get("injections", inj_run))
    cp.set('inspinj', 'seed', str(seed))
    tag = options.user_tag + "_INJECTIONS_" + inj_run.upper()

    # inspinj nodes
    inspinjJob = InspinjJob(cp, tag_base = tag.lower())
    inj_node = InspinjNode(inspinjJob, dag, tag=tag,seed = seed, p_node = [])

    # reset the config parser option back to default values
    for opt in cp.options(inj_run):
        cp.remove_option('inspinj',opt)
    cp.read(options.config_file)

    # add noilwd node
    # add sim nodes
    inj_name, = inj_node.get_output_files()
    noilwd_node = NoIlwdNode(NoIlwdJob, dag, inj_name, [inj_node])
    waveform = cp.get(inj_run, "waveform")
    sim_nodes = []
    for j in range(njobs):

        tag = "%05d" % j
        sim_name = "SBANK_SIM_%s_%s_%05d" % (options.user_tag, inj_run.upper(), j)
        sim_nodes.append(BankSimNode(banksimJob, dag, inj_name, waveform, j*injperjob, (j+1)*injperjob, sim_name, [noilwd_node]))

    # merge and plot the partial sims
    sim_names = [node.get_output_files()[0] for node in sim_nodes]
    inputs = []
    [inputs.extend(sim_node.get_output_files()[:]) for sim_node in sim_nodes]
    PlotSimNode(plotsimJob, dag, inputs, sim_nodes)

# write the dag
dag.write_sub_files()
dag.write_script()
dag.write_cache()
dag.write_dag()
